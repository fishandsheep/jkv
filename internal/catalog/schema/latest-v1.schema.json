{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fishandsheep/jkv/latest-v1.schema.json",
  "title": "jkv Catalog Latest Pointer v1",
  "type": "object",
  "required": ["schema_version", "sequence", "snapshot_sha256", "release_tag", "snapshot_asset"],
  "properties": {
    "schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 999999},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "release_tag": {"type": "string", "pattern": "^catalog-v1-[0-9]{6}$"},
    "snapshot_asset": {"type": "string", "pattern": "^[^/\\\\]+\\.json$", "maxLength": 128}
  }
}
